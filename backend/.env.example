# Copy to .env locally. Never commit real credentials.
# Local email/password authentication. Generate a random 32+ character SESSION_SECRET.
SESSION_SECRET=
TOKEN_TTL_HOURS=8
DEFAULT_TENANT_ID=default
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=HiAIDo Administrator
CORS_ORIGINS=http://localhost:8080
DATABASE_URL=postgresql+psycopg://hiaido:local-dev-only@localhost:5432/hiaido
ONTAP_BASE_URL=
ONTAP_USERNAME=
ONTAP_PASSWORD=
ONTAP_VERIFY_TLS=true
